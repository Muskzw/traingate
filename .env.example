# Copy to .env and fill in.

# Required for the AI pipeline (sectioning + question generation).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used for sectioning and question generation.
ANTHROPIC_MODEL=claude-opus-5

# Effort level for generation: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

PORT=3000

# Where the SQLite database lives.
DATABASE_PATH=./data/traingate.db

# Where uploaded source files are kept.
UPLOAD_DIR=./data/uploads

# Public base URL, used when printing certificate verification links.
PUBLIC_URL=http://localhost:3000

# Bootstrap platform administrator (created on first boot if absent).
PLATFORM_ADMIN_EMAIL=admin@traingate.local
PLATFORM_ADMIN_PASSWORD=change-me-now
